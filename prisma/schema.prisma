model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String
  tenantId  String
  tasks     Task[]   @relation("Assignees")
}

model Task {
  id        String   @id @default(uuid())
  title     String
  status    String
  tenantId  String
  assignees User[]   @relation("Assignees")
  deletedAt DateTime?
  createdAt DateTime @default(now())
}
